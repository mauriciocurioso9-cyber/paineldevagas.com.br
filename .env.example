# ============================================================
# RecrutadorIA — Variáveis de Ambiente SECRETAS
#
# ATENÇÃO: Este arquivo é apenas um TEMPLATE.
# Nunca commite o arquivo .env real.
# Adicione ".env" ao .gitignore.
#
# Como usar:
#   1. Copie este arquivo para ".env" (na raiz do projeto)
#   2. Preencha os valores abaixo
#   3. Para Supabase Edge Functions, defina os secrets via CLI:
#        supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#      ou pelo Dashboard: Supabase > Edge Functions > Secrets
# ============================================================

# ─── SUPABASE (Supabase CLI / deploy local) ─────────────────
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NÃO use no frontend — apenas scripts de admin

# ─── AI PROVIDER (define qual IA usar) ──────────────────────
# Opções: "anthropic" | "openai" | "gemini"
AI_PROVIDER=anthropic

# ─── ANTHROPIC CLAUDE (gratuito com créditos iniciais) ───────
# Obtenha em: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-COLE_SUA_CHAVE_AQUI

# ─── OPENAI (alternativa) ────────────────────────────────────
# Obtenha em: platform.openai.com > API keys
OPENAI_API_KEY=sk-COLE_SUA_CHAVE_AQUI

# ─── GOOGLE GEMINI (gratuito sem cartão de crédito) ──────────
# Obtenha em: aistudio.google.com > Get API key
GEMINI_API_KEY=AIzaSy-COLE_SUA_CHAVE_AQUI

# ─── RATE LIMIT (chamadas por minuto por IP) ─────────────────
RATE_LIMIT_RPM=20
